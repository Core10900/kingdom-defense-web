{
  "name": "kingdom-defense-web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n server,web -c blue,green \"npm run dev:server\" \"vite\"",
    "dev:server": "NODE_OPTIONS='--disable-warning=ExperimentalWarning' tsx watch server/index.ts",
    "build": "vite build",
    "start": "NODE_ENV=production NODE_OPTIONS='--disable-warning=ExperimentalWarning' tsx server/index.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "phaser": "^3.88.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.9.4"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^9.2.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.2",
    "vite": "^7.1.9"
  }
}
